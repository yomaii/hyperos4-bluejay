+
+// ---- Port: run all algorithm calls on one dedicated thread ----
+// The SenseTime library uses the TFLite GPU delegate (OpenGL), which must be called on the thread that
+// initialized it. The service starts a new thread per enroll/authenticate while the algorithm instance is
+// created once at boot, so the first frame fails (status -4). All 11 entry points go to one thread here.
+namespace {
+
+class AlgorithmThread {
+public:
+    static AlgorithmThread& instance() {
+        static AlgorithmThread* thread = new AlgorithmThread();
+        return *thread;
+    }
+
+    template <typename F>
+    auto run(F function) -> decltype(function()) {
+        using Result = decltype(function());
+        if (std::this_thread::get_id() == worker_.get_id()) {
+            return function();
+        }
+        std::packaged_task<Result()> task(std::move(function));
+        std::future<Result> result = task.get_future();
+        {
+            std::lock_guard<std::mutex> lock(mutex_);
+            queue_.emplace_back([&task] { task(); });
+        }
+        condition_.notify_one();
+        return result.get();
+    }
+
+private:
+    AlgorithmThread() : worker_([this] { loop(); }) {}
+
+    void loop() {
+        for (;;) {
+            std::function<void()> job;
+            {
+                std::unique_lock<std::mutex> lock(mutex_);
+                condition_.wait(lock, [this] { return !queue_.empty(); });
+                job = std::move(queue_.front());
+                queue_.pop_front();
+            }
+            job();
+        }
+    }
+
+    std::mutex mutex_;
+    std::condition_variable condition_;
+    std::deque<std::function<void()>> queue_;
+    std::thread worker_;
+};
+
+template <typename F>
+auto onAlgorithmThread(F function) -> decltype(function()) {
+    return AlgorithmThread::instance().run(std::move(function));
+}
+
+}  // namespace
+
+extern "C" FacehalAlgorithm* facehal_algorithm_open(const char* template_directory) {
+    return onAlgorithmThread([=] { return facehal_algorithm_open_impl(template_directory); });
+}
+
+extern "C" void facehal_algorithm_close(FacehalAlgorithm* algorithm) {
+    onAlgorithmThread([=] { facehal_algorithm_close_impl(algorithm); });
+}
+
+extern "C" int32_t facehal_algorithm_process_nv21(
+        FacehalAlgorithm* algorithm, const uint8_t* image, size_t image_size, int32_t width,
+        int32_t height, int32_t stride, int32_t action, int32_t config) {
+    return onAlgorithmThread([=] {
+        return facehal_algorithm_process_nv21_impl(
+                algorithm, image, image_size, width, height, stride, action, config);
+    });
+}
+
+extern "C" int32_t facehal_algorithm_current_face_id(const FacehalAlgorithm* algorithm) {
+    return onAlgorithmThread([=] { return facehal_algorithm_current_face_id_impl(algorithm); });
+}
+
+extern "C" int32_t facehal_algorithm_enumerate(
+        const FacehalAlgorithm* algorithm, int32_t* enrollment_ids, size_t capacity) {
+    return onAlgorithmThread(
+            [=] { return facehal_algorithm_enumerate_impl(algorithm, enrollment_ids, capacity); });
+}
+
+extern "C" int32_t facehal_algorithm_slots(
+        const FacehalAlgorithm* algorithm, int32_t* enrollment_ids, size_t capacity) {
+    return onAlgorithmThread(
+            [=] { return facehal_algorithm_slots_impl(algorithm, enrollment_ids, capacity); });
+}
+
+extern "C" int32_t facehal_algorithm_remove(FacehalAlgorithm* algorithm, int32_t enrollment_id) {
+    return onAlgorithmThread([=] { return facehal_algorithm_remove_impl(algorithm, enrollment_id); });
+}
+
+extern "C" int32_t facehal_algorithm_remove_all(FacehalAlgorithm* algorithm) {
+    return onAlgorithmThread([=] { return facehal_algorithm_remove_all_impl(algorithm); });
+}
+
+extern "C" int32_t facehal_algorithm_set_active_slot(FacehalAlgorithm* algorithm, int32_t slot) {
+    return onAlgorithmThread([=] { return facehal_algorithm_set_active_slot_impl(algorithm, slot); });
+}
+
+extern "C" int32_t facehal_algorithm_reset(FacehalAlgorithm* algorithm) {
+    return onAlgorithmThread([=] { return facehal_algorithm_reset_impl(algorithm); });
+}
+
