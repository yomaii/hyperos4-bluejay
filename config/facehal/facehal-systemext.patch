diff --git a/native/LogRedirect.cpp b/native/LogRedirect.cpp
new file mode 100644
index 0000000..716c809
--- /dev/null
+++ b/native/LogRedirect.cpp
@@ -0,0 +1,66 @@
+// Port: init connects stderr of services to /dev/null, so HAL diagnostics (eprintln!, fprintf(stderr)) are lost.
+// Pipe fd 2 into a thread that forwards lines to logcat (tag FaceHAL). The camera worker does the same.
+#include <android/log.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+namespace {
+
+void* pump(void* arg) {
+    const int fd = static_cast<int>(reinterpret_cast<intptr_t>(arg));
+    char buffer[1024];
+    size_t length = 0;
+    for (;;) {
+        const ssize_t count = read(fd, buffer + length, sizeof(buffer) - 1 - length);
+        if (count < 0 && errno == EINTR) {
+            continue;
+        }
+        if (count <= 0) {
+            break;
+        }
+        length += static_cast<size_t>(count);
+        size_t start = 0;
+        for (size_t index = 0; index < length; ++index) {
+            if (buffer[index] == '\n') {
+                buffer[index] = '\0';
+                __android_log_write(ANDROID_LOG_INFO, "FaceHAL", buffer + start);
+                start = index + 1;
+            }
+        }
+        if (start == 0 && length == sizeof(buffer) - 1) {
+            buffer[length] = '\0';
+            __android_log_write(ANDROID_LOG_INFO, "FaceHAL", buffer);
+            length = 0;
+        } else {
+            memmove(buffer, buffer + start, length - start);
+            length -= start;
+        }
+    }
+    close(fd);
+    return nullptr;
+}
+
+}  // namespace
+
+extern "C" void facehal_redirect_stderr_to_log() {
+    int fds[2];
+    if (pipe2(fds, O_CLOEXEC) != 0) {
+        return;
+    }
+    if (dup2(fds[1], STDERR_FILENO) < 0) {
+        close(fds[0]);
+        close(fds[1]);
+        return;
+    }
+    close(fds[1]);
+    setvbuf(stderr, nullptr, _IONBF, 0);
+    pthread_t thread;
+    if (pthread_create(&thread, nullptr, pump, reinterpret_cast<void*>(static_cast<intptr_t>(fds[0]))) == 0) {
+        pthread_detach(thread);
+    }
+}
