; Appended to system_ext_sepolicy.cil.

; Shannon IMS / RCS / QNS domains: the Pixel system_ext half (vendor half is in the Pixel vendor policy).
; Without them the apps run as priv_app, cannot set persist.vendor.radio.* and ShannonIms keeps crashing.
(typeattributeset domain (vendor_ims_app vendor_rcs_app))
(typeattributeset appdomain (vendor_ims_app vendor_rcs_app))
(typeattributeset netdomain (vendor_ims_app vendor_rcs_app))
(typeattributeset coredomain (vendor_ims_app vendor_rcs_app))
(type vendor_ims_app_userfaultfd)
(roletype object_r vendor_ims_app_userfaultfd)
(type vendor_ims_app_block_io_uring)
(roletype object_r vendor_ims_app_block_io_uring)
(type vendor_ims_app_wrapfd)
(roletype object_r vendor_ims_app_wrapfd)
(type vendor_rcs_app_userfaultfd)
(roletype object_r vendor_rcs_app_userfaultfd)
(type vendor_rcs_app_block_io_uring)
(roletype object_r vendor_rcs_app_block_io_uring)
(type vendor_rcs_app_wrapfd)
(roletype object_r vendor_rcs_app_wrapfd)
(typetransition vendor_ims_app tmpfs file appdomain_tmpfs)
(allow vendor_ims_app vendor_ims_app_userfaultfd (anon_inode (ioctl read create)))
(dontaudit su vendor_ims_app_userfaultfd (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(allow vendor_ims_app appdomain_tmpfs (file (read write getattr map execute)))
(allow vendor_ims_app appdomain (memfd_file (read write getattr map execute)))
(allow vendor_ims_app app_api_service (service_manager (find)))
(allow vendor_ims_app audioserver_service (service_manager (find)))
(allow vendor_ims_app radio_service (service_manager (find)))
(allow vendor_ims_app mediaserver_service (service_manager (find)))
(allow vendor_ims_app cameraserver_service (service_manager (find)))
(allow vendor_ims_app mediametrics_service (service_manager (find)))
(allow vendor_ims_app self (udp_socket (read write create getattr setattr lock append map bind connect getopt setopt shutdown)))
(allow vendor_ims_app property_socket (sock_file (write)))
(allow vendor_ims_app init (unix_stream_socket (connectto)))
(allow vendor_ims_app radio_prop (property_service (set)))
(allow vendor_ims_app radio_prop (file (read getattr map open)))
(typetransition vendor_rcs_app tmpfs file appdomain_tmpfs)
(allow vendor_rcs_app vendor_rcs_app_userfaultfd (anon_inode (ioctl read create)))
(dontaudit su vendor_rcs_app_userfaultfd (anon_inode (ioctl read write create getattr setattr lock relabelfrom relabelto append map unlink link rename execute quotaon mounton audit_access open execmod watch watch_mount watch_sb watch_with_perm watch_reads)))
(allow vendor_rcs_app appdomain_tmpfs (file (read write getattr map execute)))
(allow vendor_rcs_app appdomain (memfd_file (read write getattr map execute)))
(allow vendor_rcs_app app_api_service (service_manager (find)))
(allow vendor_rcs_app audioserver_service (service_manager (find)))
(allow vendor_rcs_app radio_service (service_manager (find)))
(allow vendor_rcs_app mediaserver_service (service_manager (find)))
(allow vendor_rcs_app cameraserver_service (service_manager (find)))
(allow vendor_rcs_app property_socket (sock_file (write)))
(allow vendor_rcs_app init (unix_stream_socket (connectto)))
(allow vendor_rcs_app radio_prop (property_service (set)))
(allow vendor_rcs_app radio_prop (file (read getattr map open)))
(typetransition vendor_rcs_app vendor_rcs_app anon_inode "[wrapfd]" vendor_rcs_app_wrapfd)
(typetransition vendor_rcs_app vendor_rcs_app anon_inode "[io_uring]" vendor_rcs_app_block_io_uring)
(typetransition vendor_rcs_app vendor_rcs_app anon_inode "[userfaultfd]" vendor_rcs_app_userfaultfd)
(typetransition vendor_ims_app vendor_ims_app anon_inode "[wrapfd]" vendor_ims_app_wrapfd)
(typetransition vendor_ims_app vendor_ims_app anon_inode "[io_uring]" vendor_ims_app_block_io_uring)
(typetransition vendor_ims_app vendor_ims_app anon_inode "[userfaultfd]" vendor_ims_app_userfaultfd)
; HyperOS looks up HyperOSCustFeatureResolve in every app process
(allow vendor_ims_app hyperos_cust_feature_resolve_service (service_manager (find)))
(allow vendor_rcs_app hyperos_cust_feature_resolve_service (service_manager (find)))
