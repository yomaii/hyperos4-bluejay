# PowerManagerService.onBootPhase: start PortPerfBridge after systemReady() (PHASE_SYSTEM_SERVICES_READY).
# Format: see tools/jar_smali.py.
.in-method .method public onBootPhase(I)V
.after invoke-direct {p0}, Lcom/android/server/power/PowerManagerService;->systemReady()V
    iget-object v0, p0, Lcom/android/server/power/PowerManagerService;->mContext:Landroid/content/Context;
    invoke-static {v0}, Lcom/android/server/power/PortPerfBridge;->start(Landroid/content/Context;)V
