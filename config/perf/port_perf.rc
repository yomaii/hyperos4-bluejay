# HyperOS power-saving / performance modes -> Pixel Power HAL LOW_POWER_* hints.
# Generated by config/perf/gen_rc.py.
#
# PortPerfBridge (services.jar) sets
#   sys.port.perfmode       perf / balance / save / super
#   sys.port.perfmode.tick  bumped at boot and every 50 minutes (the hints expire after an hour)
# init -> sendhint_vendor is an existing domain transition in the Pixel policy.
#
#   mode      level   little   mid   big (MHz)
#   perf      none    1803   2253   2802
#   balance   90      1803   1999   2401
#   save      70      1328   1663   1745
#   super     50       930    910   1277

on property:sys.port.perfmode=perf
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_50 -e 0

on property:sys.port.perfmode=balance
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_90 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_90 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_90 -e 1

on property:sys.port.perfmode=save
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_50 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_70 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_70 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_70 -e 1

on property:sys.port.perfmode=super
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_90 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_70 -e 0
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_50 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_50 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_50 -e 1

on property:sys.port.perfmode.tick=* && property:sys.port.perfmode=balance
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_90 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_90 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_90 -e 1

on property:sys.port.perfmode.tick=* && property:sys.port.perfmode=save
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_70 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_70 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_70 -e 1

on property:sys.port.perfmode.tick=* && property:sys.port.perfmode=super
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_CPU_50 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_MID_CLUSTER_50 -e 1
    exec_background -- /vendor/bin/sendhint -m LOW_POWER_LITTLE_CLUSTER_50 -e 1
